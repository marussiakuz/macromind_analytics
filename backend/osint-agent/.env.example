# === Application ===
APP_NAME=osint-agent
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=osint
POSTGRES_USER=osint
POSTGRES_PASSWORD=changeme

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# === Neo4j ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# === Qdrant (for future use with LLM) ===
QDRANT_HOST=localhost
QDRANT_PORT=6333

# === VK API ===
VK_SERVICE_TOKEN=
VK_API_VERSION=5.131

# === External APIs (optional, for paid sources) ===
SPARK_API_KEY=
KONTUR_API_KEY=
PROXYCURL_API_KEY=
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
CRUNCHBASE_API_KEY=

# === Shodan (optional — service works without it, but adds IP/domain intelligence) ===
# Get free API key at https://account.shodan.io/
# Free plan: 100 requests/month
# Service will gracefully skip Shodan if key is missing or credits exhausted
SHODAN_API_KEY=

# === Sanctions registries ===
# Local mirror update cron (default: daily at 03:00)
SANCTIONS_UPDATE_CRON=0 3 * * *

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === Rate limiting ===
RATE_LIMIT_ENABLED=true

# Checko: https://checko.ru/integration/api
CHECKO_API_KEY=
DEMO_MODE=false

# Market module (plan §7)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
OPENALEX_API_KEY=

# LLM provider (MIMO Market Recovery §3)
# provider: "yandex" (Yandex Studio) or "local" (llama-server / OpenAI-compatible)
LLM_PROVIDER=yandex
# For local: base URL of the llama-server, e.g. http://127.0.0.1:8080/v1
LLM_BASE_URL=
# Model name or URI; empty = provider default
LLM_MODEL=
# API key (optional for local; required for Yandex)
LLM_API_KEY=
LLM_CONTEXT_SIZE=16384
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_S=600
LLM_TEMPERATURE=0.0

# Search provider (MIMO_EXA_SETUP / MIMO_TAVILY_SETUP)
# provider: "exa" (Exa Search) | "tavily" (Tavily Search) | "yandex" (Yandex Search)
SEARCH_PROVIDER=exa
# Явно включённое резервирование: запасной поиск при недоступности основного
SEARCH_FALLBACK=false
SEARCH_FALLBACK_PROVIDER=tavily
SEARCH_FALLBACK_BUDGET=2

# Knowledge / RAG (optional; leave URL empty to run company checks without RAG)
KNOWLEDGE_DATABASE_URL=
KNOWLEDGE_OBJECTS_ROOT=data/knowledge-objects
KNOWLEDGE_INTERNAL_TOKEN=
# Example format only: analyst:REPLACE_WITH_USER_TOKEN:workspace-1
KNOWLEDGE_USER_ACCESS=
EMBEDDING_BASE_URL=http://127.0.0.1:8091
EMBEDDING_API_TOKEN=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_REVISION=main
EMBEDDING_DIMENSION=1024
KNOWLEDGE_SCHEMA_VERSION=0004
KNOWLEDGE_SEARCH_PROFILE=v1
KNOWLEDGE_JOB_DEADLINE_SECONDS=1800
KNOWLEDGE_MAX_PARALLEL_JOBS=1

# Exa semantic search (server-side only)
EXA_API_KEY=
