# Task2 RAG / knowledge base — application env example (no secrets).
# Copy to .env and fill. Never commit real values.

# --- PostgreSQL (role: application) ---
KNOWLEDGE_DATABASE_URL=postgresql://knowledge:change-me@127.0.0.1:5433/knowledge

# --- Persistent objects (server 1) ---
KNOWLEDGE_OBJECTS_ROOT=/srv/macromind-knowledge/objects

# --- Internal app API (server 1) ---
KNOWLEDGE_INTERNAL_BASE_URL=https://knowledge.internal:8002
KNOWLEDGE_INTERNAL_TOKEN=change-me-service-token

# --- Embedding service (server 2) ---
EMBEDDING_BASE_URL=http://127.0.0.1:8091
EMBEDDING_API_TOKEN=change-me-service-token
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_REVISION=main
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=1
EMBEDDING_MAX_INPUT_TOKENS=1024
EMBEDDING_THREADS=4

# --- Limits / reproducibility ---
KNOWLEDGE_SCHEMA_VERSION=0002
KNOWLEDGE_SEARCH_PROFILE=v1
KNOWLEDGE_JOB_DEADLINE_SECONDS=1800
KNOWLEDGE_MAX_PARALLEL_JOBS=1
